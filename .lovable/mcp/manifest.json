{
  "version": 1,
  "sdk_version": "3.0.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "jume-college-portal",
      "version": "0.1.0",
      "title": "Jume College Portal"
    },
    "tools": [
      {
        "name": "list_courses",
        "title": "List courses",
        "description": "List the training courses offered by JUME College - OTEPIC Kenya, with a summary and prospectus PDF link for each.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "minLength": 1,
              "description": "Optional keyword to filter courses by title or summary."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_course",
        "title": "Get course details",
        "description": "Get full details and the prospectus PDF link for one course, by its title or slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "course": {
              "type": "string",
              "minLength": 1,
              "description": "Course title or slug, e.g. 'Permaculture Course' or 'plumbing'."
            }
          },
          "required": [
            "course"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_college_info",
        "title": "Get college info",
        "description": "Get contact details, location, director and key page links for JUME College - OTEPIC Kenya.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_impact_stats",
        "title": "Get impact stats",
        "description": "Get the college's headline impact numbers and where donations are used.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
